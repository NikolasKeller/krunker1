{
  "name": "krunker-local-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/integration.ts",
    "test:soak": "tsx tests/soak.ts",
    "test:lifecycle": "tsx tests/lifecycle.ts",
    "test:production": "node tests/production.mjs",
    "test:lobby": "tsx tests/lobby.ts",
    "test:lobby:flow": "tsx tests/lobby-flow.ts",
    "test:load": "tsx tests/load.ts",
    "preview:geometry": "tsx tests/geometry-preview.ts",
    "preview:hud": "tsx tests/hud-preview.ts"
  },
  "dependencies": {
    "three": "0.185.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.10",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=22"
  }
}
