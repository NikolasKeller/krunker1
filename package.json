{
  "name": "krunker-local-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/compress-client.mjs && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "test": "tsx --test tests/*.test.ts",
    "audit:map": "tsx scripts/audit-map-geometry.ts",
    "test:movement": "tsx --test tests/movement-stall.test.ts",
    "test:movement:ws": "tsx tests/movement-websocket.ts",
    "test:bad-link": "tsx --test tests/bad-link.test.ts tests/local-motion.test.ts tests/input-recovery.test.ts",
    "test:bad-link:ws": "tsx tests/bad-link-websocket.ts",
    "test:hitscan:ws": "tsx tests/hitscan-websocket.ts",
    "test:integration": "tsx tests/integration.ts",
    "test:soak": "tsx tests/soak.ts",
    "test:lifecycle": "tsx tests/lifecycle.ts",
    "test:production": "node tests/production.mjs",
    "test:lobby": "tsx tests/lobby.ts",
    "test:lobby:flow": "tsx tests/lobby-flow.ts",
    "test:load": "tsx tests/load.ts",
    "probe:transport:live": "tsx tests/transport/live.ts",
    "probe:transport:model": "tsx tests/transport/model-report.ts",
    "probe:transport:pair": "tsx tests/transport/paired.ts",
    "preview:geometry": "tsx tests/geometry-preview.ts",
    "preview:maps": "tsx tests/maps-preview.ts",
    "test:maps": "tsx --test tests/maps-*.test.ts tests/map-geometry.test.ts",
    "preview:hud": "tsx tests/hud-preview.ts",
    "preview:lobby": "tsx tests/lobby-preview.ts",
    "preview:home": "tsx tests/home-preview.ts",
    "test:combat:ws": "tsx tests/combat-latency.ts",
    "preview:mobile": "tsx tests/mobile-preview.ts",
    "test:ammo:latency": "tsx tests/ammo-latency.ts"
  },
  "dependencies": {
    "three": "0.185.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.10",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "werift": "0.24.4"
  },
  "engines": {
    "node": ">=22"
  }
}
